HOST=127.0.0.1
PORT=8000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-secret

# Render (https://cyber-cotheth-tech-networks-1.onrender.com) — set in Render dashboard:
# NODE_ENV=production
# SESSION_SECRET=<long-random-string>
# HOST=0.0.0.0  (optional; auto-detected when PORT is set)
# Note: SQLite in data/cctn.db is wiped on every Render restart/redeploy.
# For production, use Render PostgreSQL or a persistent disk mount.

# Angwa Pay gateway (get credentials from https://frontend.adamic.co.zw → Merchants → Security)
# Live API (Cloudflare tunnel):
ANGWA_BASE_URL=https://developer.adamic.co.zw
ANGWA_API_KEY=your-api-key
ANGWA_API_SECRET=your-api-secret
# Must match a domain whitelisted on your merchant profile (no https:// prefix)
# Local / custom domain:  www.cybercothtechnetworks.co.zw
# Render:                 cyber-cotheth-tech-networks-1.onrender.com
ANGWA_MERCHANT_DOMAIN=cyber-cotheth-tech-networks-1.onrender.com
# EcoCash routing (Angwa Pay WalletRoutingValidator):
# Deposits  → ECOCASH_DIRECT (real-time) for Merchant+Ecopay companies
# Withdrawals → ECOPAY bulk batch (default) — uses name + national ID from user profile
ANGWA_ECOCASH_DEPOSIT_PROVIDER=ECOCASH_DIRECT
ANGWA_ECOCASH_WITHDRAW_PROVIDER=ECOPAY
# PayPulse-only companies: ANGWA_ECOCASH_WITHDRAW_PROVIDER=PAYPULSE_ECOCASH
